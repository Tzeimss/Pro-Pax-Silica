CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

database.default.hostname = localhost
database.default.database = sunsonsolar
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# Required only when running `php spark db:seed InitialAdmins` on a new database.
# Use distinct random values of at least 12 characters and keep them private in .env.
SUNSON_FOUNDER_ADMIN_PASSWORD =
SUNSON_IT_ADMIN_PASSWORD =
