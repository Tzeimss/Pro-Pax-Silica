{
    "name": "sunsonsolar/website",
    "description": "Sun Son Solar website built with CodeIgniter 4",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "config": {"optimize-autoloader": true, "sort-packages": true},
    "require-dev": {
        "kint-php/kint": "^6.1"
    }
}
